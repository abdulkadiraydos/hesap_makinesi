<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hesap_makinesi.SettingsPage"
             Title="Ayarlar">

    <VerticalStackLayout Padding="30" Spacing="20">
        <Label Text="Uygulama Teması" 
               FontSize="22" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"/>

        <Picker x:Name="ThemePicker" 
                Title="Tema Seçiniz"
                SelectedIndexChanged="OnThemePickerChanged"
                FontSize="18">
            <Picker.Items>
                <x:String>Açık (Light)</x:String>
                <x:String>Koyu (Dark)</x:String>
                <x:String>Sistem Ayarını Kullan</x:String>
            </Picker.Items>
        </Picker>
    </VerticalStackLayout>
</ContentPage>